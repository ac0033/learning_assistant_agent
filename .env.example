# ============================================================================
# LLM Configuration
# ============================================================================

# Anthropic-compatible API key (Required)
# DeepSeek users: get your key at https://platform.deepseek.com/api_keys
ANTHROPIC_API_KEY=sk-xxx

# Model ID (Required)
# DeepSeek: deepseek-v4-flash
# Anthropic: claude-sonnet-4-6
# OpenRouter: openai/gpt-4o, anthropic/claude-sonnet-4-6, etc.
MODEL_ID=deepseek-v4-flash

# Custom base URL for Anthropic-compatible APIs
# DeepSeek: https://api.deepseek.com/anthropic
# OpenRouter: https://openrouter.ai/api/v1
# Leave empty for default Anthropic API endpoint
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ============================================================================
# Embedding Configuration — CHOOSE ONE PROVIDER BELOW
# ============================================================================
# You need embeddings to convert text into vectors for RAG retrieval.
# Pick ONE provider and fill in the corresponding API key + config.

# --- Option A: SiliconFlow (Recommended — free tier, no overseas payment) ---
# Why: BGE-M3 has top-tier Chinese-English quality, 2000万 tokens free,
#      OpenAI-compatible API, WeChat/Alipay for paid tier.
# Get key: https://siliconflow.cn → 注册 → API密钥
# Model options: BAAI/bge-m3 (multilingual), BAAI/bge-large-zh-v1.5 (Chinese-optimized)
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_API_KEY=sk-xxx

# --- Option B: OpenAI ---
# Why: text-embedding-3-small is cheap ($0.02/1M tokens), widely available.
# Requires overseas payment method.
# Get key: https://platform.openai.com/api_keys
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-xxx

# --- Option C: Voyage AI (Anthropic partner, best quality) ---
# Why: voyage-3 has top-tier multilingual quality, Anthropic's recommended partner.
# Requires overseas payment method.
# Get key: https://dash.voyageai.com/
# EMBEDDING_PROVIDER=voyage
# EMBEDDING_MODEL=voyage-3
# VOYAGE_API_KEY=pa-xxx

# ============================================================================
# Chainlit
# ============================================================================
CHAINLIT_PORT=8000
CHAINLIT_AUTH_ENABLED=false

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO
